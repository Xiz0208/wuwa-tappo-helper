# 默认：自动识别文本文件，并在仓库里统一用 LF 存储
* text=auto

# Windows 脚本必须保持 CRLF —— .bat 用 LF 换行在部分环境下会执行异常
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.txt  text eol=crlf

# 文档用 LF
*.md   text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf
LICENSE       text eol=lf

# 二进制/生成物，不做换行转换
*.png  binary
*.ico  binary
*.zip  binary
